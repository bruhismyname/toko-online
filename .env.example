# Supabase Configuration - Wajib diisi
# URL endpoint Supabase project Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon/Public yang dapat diakses klien (digunakan di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key untuk operasi administratif (JANGAN PERNAH diekspos ke klien!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret untuk mengenkripsi/mendekripsi token (buat random string yang kompleks)
JWT_SECRET=your-secure-jwt-secret

# Environment (development, production, testing)
NODE_ENV=development

# Port untuk menjalankan server (opsional, default: 3000)
PORT=3000

# URL aplikasi, digunakan untuk callback auth (opsional jika menggunakan NextAuth)
# NEXTAUTH_URL=http://localhost:3000